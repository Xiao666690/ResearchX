FROM python:3.11-slim

WORKDIR /app
COPY requirements-agentarts.txt ./
RUN pip install --no-cache-dir -r requirements-agentarts.txt
COPY core ./core
COPY integrations ./integrations
COPY arxiv_client.py ./

ENV PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["uvicorn", "integrations.agentarts.runtime_app:app", "--host", "0.0.0.0", "--port", "8080"]

# Copy to .env.prod for the production build, or .env.dev for local development.
# /api is proxied by nginx to the FastAPI service on 127.0.0.1:8001.
VITE_DEPLOY_BASE_URL=/
VITE_API_BASE_URL=/api
VITE_APP_DEFAULT_THEME=light
VITE_APP_NAME=ResearchX
VITE_APP_TITLE=ResearchX
VITE_APP_DESC=Evidence-led research agent and knowledge workspace
VITE_APP_KEYWORDS=ResearchX,AI,RAG,paper,research
VITE_STORAGE_PREFIX=researchx
